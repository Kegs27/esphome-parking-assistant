# ESPHome Secrets Configuration Template
# 
# Copy this file to 'secrets.yaml' in the same directory and fill in your own values.
# WARNING: NEVER commit secrets.yaml to git!
#
# The real secrets.yaml is already in .gitignore

# Wi-Fi Configuration
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# API Encryption Key (generate with: esphome config <file>.yaml and copy from output)
# Or generate manually: openssl rand -base64 32
api_encryption_key: "your-32-character-base64-key-here=="

# OTA (Over-The-Air) Update Password
ota_password: "your-ota-password-here"

# Fallback Hotspot Password (used if Wi-Fi connection fails)
fallback_password: "fallback-ap-password"

# Notes:
# 1. To generate a secure API key, run: openssl rand -base64 32
# 2. Or let ESPHome generate one on first compile: it will show in the logs
# 3. OTA password should be different from Wi-Fi password
# 4. Fallback password is for the ESP32's access point mode (if main Wi-Fi fails)
